{
  "name": "l-ext",
  "displayName": "l-ext",
  "description": "schema to crud app",
  "version": "0.0.1",
  "type": "commonjs",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbanem/l-ext.git"
  },
  "license": "MIT",
  "publisher": "mbanem",
  "contributes": {
    "commands": [
      {
        "command": "l-ext.crudTest",
        "title": "CRUD l-ext"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm --filter ./src/webview-ui check",
    "compile": "tsc -p . --noEmit && rm -rf out && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js --sourcemap",
    "build:webview": "cd src/webview-ui && pnpm run build",
    "build": "pnpm compile && pnpm build:webview",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies",
    "ix": "pnpm run package && VERSION=$(jq -r '.version' package.json) && code --install-extension l-ext-${VERSION}.vsix --force"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "@prisma/internals": "^7.8.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bcrypt": "^6.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "postcss": "^8.5.18",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "^7.10.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.101.0",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "svelte-preprocess": "^6.0.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "dotenv": "^17.4.2",
    "vite-plugin-sass-dts": "^1.3.37"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0"
  }
}
