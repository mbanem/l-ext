
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension (WSL)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test-workspace"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/.vscode-server/**"
      ],
      "preLaunchTask": "watch" 
    }
  ]
}
