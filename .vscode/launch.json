{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=/home/mili/Ext/PreviousStages/l-ext"
        // Force the temporary instance to load your exact WSL path
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
